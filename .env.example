# Verity local configuration. Copy to .env and edit. Never commit .env.
#
# M0 requires NO secrets and NO model provider. The verifier is deterministic
# and makes zero model calls by design.

# Sandbox
VERITY_SANDBOX_URL=http://127.0.0.1:8099
VERITY_SANDBOX_SEED=1

# Evidence store location
VERITY_EVIDENCE_DIR=.verity/evidence

# Connector cassettes (hermetic CI). one of: off | record | replay
VERITY_CASSETTE_MODE=off
VERITY_CASSETTE_DIR=tests/cassettes
