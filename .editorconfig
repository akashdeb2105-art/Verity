# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yaml,yml,json,ts,js,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false  # two trailing spaces is a hard line break

[Makefile]
indent_style = tab

[*.{diff,patch}]
trim_trailing_whitespace = false
