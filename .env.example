# Verity local configuration. Copy to .env and edit. Never commit .env.
#
# M0 requires NO secrets and NO model provider. The verifier is deterministic
# and makes zero model calls by design.

# Sandbox
VERITY_SANDBOX_URL=http://127.0.0.1:8099
VERITY_SANDBOX_SEED=1

# Evidence store location
VERITY_EVIDENCE_DIR=.verity/evidence

# Connector cassettes (hermetic CI). one of: off | record | replay
VERITY_CASSETTE_MODE=off
VERITY_CASSETTE_DIR=tests/cassettes

# ---------------------------------------------------------------- authoring
# A model is used ONLY by `verity teach --ai` / `verity inspect --ai`, to
# suggest checks a single recording could not contain. The verifier never
# calls one, and an import rule stops it from being able to. Leave this unset
# and everything except those suggestions still works.
#
# One provider, or a '+'-separated fallback chain tried in order. Free
# endpoints get rate limited and models get retired, so a chain means a dead
# model costs a fallback rather than the run.
VERITY_LLM_PROVIDER=codecraft+fireworks+gemini

# Override the model for the first provider in the chain.
# VERITY_LLM_MODEL=

# Whichever providers you name above. Keys go in .env, never here.
# CODECRAFT_API_KEY=   # an OpenAI-compatible aggregator; keys look like cc_...
# FIREWORKS_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ollama needs no key and runs on your own machine.

# Replay recorded model exchanges instead of calling out. one of: off | record | replay
VERITY_AI_CASSETTE_MODE=off
