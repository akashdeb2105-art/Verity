# The portability boundary is non-negotiable (final direction, section 6).
# These contracts are written BEFORE runtime/capture/compiler exist, so the
# boundary cannot be violated even once.

[importlinter]
# Several of these contracts were written before the packages they constrain
# existed. That was the point: a boundary declared first cannot be violated
# even once, and none of them has been.
include_external_packages = True
root_packages =
    verity_schema
    verity_evidence
    verity_connectors
    verity_extract
    verity_verifier
    verity_capture
    verity_compiler
    verity_runtime
    verity_ai
    verity_cli
    verity_sandbox

[importlinter:contract:verifier-independence]
name = Verifier must not depend on any executor, capture or compiler
type = forbidden
source_modules =
    verity_verifier
forbidden_modules =
    verity_runtime
    verity_capture
    verity_compiler
    verity_runtime
    verity_ai
    verity_cli
    verity_sandbox
allow_indirect_imports = False

[importlinter:contract:verification-is-deterministic]
name = The verifier must never reach a model provider
type = forbidden
source_modules =
    verity_verifier
forbidden_modules =
    verity_ai
    openai
    anthropic
    cohere
    litellm
    langchain
allow_indirect_imports = False

[importlinter:contract:schema-is-a-leaf]
name = Schema depends on nothing else in the project
type = forbidden
source_modules =
    verity_schema
forbidden_modules =
    verity_evidence
    verity_connectors
    verity_extract
    verity_verifier
    verity_capture
    verity_compiler
    verity_runtime
    verity_ai
    verity_cli
    verity_sandbox

[importlinter:contract:layering]
name = Package layering
type = layers
layers =
    verity_cli
    verity_verifier | verity_compiler
    verity_capture
    verity_ai
    verity_connectors | verity_extract | verity_evidence
    verity_schema

# verity_ai sits BELOW the verifier in these layers, and the forbidden contract
# above stops the verifier reaching it at all. A model may help author a
# contract; it may never help decide whether one passed.
#
# 'verity_verifier | verity_compiler' places them side by side deliberately:
# neither may import the other. The compiler proposes contracts; the verifier
# evaluates them. Coupling the two would mean a contract could only be checked
# by the thing that wrote it, which is the opposite of the point.

[importlinter:contract:capture-does-not-verify]
name = Capture records what happened and never judges it
type = forbidden
source_modules =
    verity_capture
forbidden_modules =
    verity_verifier
    verity_compiler
    verity_cli
    verity_sandbox

[importlinter:contract:sandbox-is-a-fixture]
name = The sandbox is a fixture and must not import Verity logic
type = forbidden
source_modules =
    verity_sandbox
forbidden_modules =
    verity_verifier
    verity_connectors
    verity_extract
    verity_cli

[importlinter:contract:runtime-and-verifier-are-independent]
name = The runtime and the verifier must not know about each other
type = forbidden
source_modules =
    verity_runtime
    verity_verifier
forbidden_modules =
    verity_verifier
    verity_runtime
allow_indirect_imports = False

[importlinter:contract:execution-is-deterministic]
name = The executor must never reach a model provider
type = forbidden
source_modules = verity_runtime
forbidden_modules =
    verity_ai
    openai
    anthropic
    litellm
allow_indirect_imports = False
